#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Z"
)

# Project-owned calibration fixture.  It deliberately contains one infinite
# collision Plane and no NVIDIA Warehouse opinions.
def Xform "Root"
{
    def Xform "GroundPlane"
    {
        def Plane "CollisionPlane" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            bool physics:collisionEnabled = true
            uniform token purpose = "guide"
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
    bool physxScene:enableCCD = true
    bool physxScene:enableStabilization = true
    float physxScene:frictionCorrelationDistance = 0.00025
    float physxScene:frictionOffsetThreshold = 0.0004
    uniform token physxScene:frictionType = "patch"
    uniform token physxScene:solverType = "TGS"
    uint physxScene:timeStepsPerSecond = 60
}
