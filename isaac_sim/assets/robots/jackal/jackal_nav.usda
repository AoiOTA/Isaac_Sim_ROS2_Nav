#usda 1.0
(
    defaultPrim = "jackal"
    metersPerUnit = 1
    subLayers = [
        @./source/jackal_original.usd@
    ]
    upAxis = "Z"
)

over "jackal"
{
    # The imported 2022 Jackal asset authors the removed PhysX
    # `customGeometry` property on every wheel. PhysX warns whenever that
    # property exists, even when it is false or value-blocked, so the project
    # overlay deactivates each legacy collider and supplies an equivalent
    # standard Cylinder without modifying the imported source crate.
    over "front_left_wheel_link"
    {
        over "collisions" (
            active = false
        )
        {
        }

        def Cylinder "collisions_v2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.098, -0.098, -0.02), (0.098, 0.098, 0.02)]
            double height = 0.04
            bool physics:collisionEnabled = true
            uniform token purpose = "guide"
            double radius = 0.098
            rel material:binding = </jackal/PhysicsMaterials/wheels>
            quatd xformOp:orient = (0.7071067811865476, 0.7071067811865476, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "front_right_wheel_link"
    {
        over "collisions" (
            active = false
        )
        {
        }

        def Cylinder "collisions_v2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.098, -0.098, -0.02), (0.098, 0.098, 0.02)]
            double height = 0.04
            bool physics:collisionEnabled = true
            uniform token purpose = "guide"
            double radius = 0.098
            rel material:binding = </jackal/PhysicsMaterials/wheels>
            quatd xformOp:orient = (0.7071067811865476, 0.7071067811865476, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "rear_left_wheel_link"
    {
        over "collisions" (
            active = false
        )
        {
        }

        def Cylinder "collisions_v2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.098, -0.098, -0.02), (0.098, 0.098, 0.02)]
            double height = 0.04
            bool physics:collisionEnabled = true
            uniform token purpose = "guide"
            double radius = 0.098
            rel material:binding = </jackal/PhysicsMaterials/wheels>
            quatd xformOp:orient = (0.7071067811865476, 0.7071067811865476, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "rear_right_wheel_link"
    {
        over "collisions" (
            active = false
        )
        {
        }

        def Cylinder "collisions_v2" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.098, -0.098, -0.02), (0.098, 0.098, 0.02)]
            double height = 0.04
            bool physics:collisionEnabled = true
            uniform token purpose = "guide"
            double radius = 0.098
            rel material:binding = </jackal/PhysicsMaterials/wheels>
            quatd xformOp:orient = (0.7071067811865476, 0.7071067811865476, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "base_link"
    {
        over "sick_lms1xx_lidar_frame" (
            active = false
        )
        {
        }

        over "com_frame" (
            active = false
        )
        {
        }

        over "bumblebee_stereo_camera_frame" (
            active = false
        )
        {
        }

        def Xform "lidar_link"
        {
            double3 xformOp:translate = (0.120, 0.000, 0.333)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "imu_link"
        {
            double3 xformOp:translate = (0.012, 0.002, 0.067)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "camera_link"
        {
            double3 xformOp:translate = (0.247, 0.000, 0.218)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "camera_front_link"
            {
                double3 xformOp:translate = (0.000, 0.000, 0.000)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Xform "camera_front_optical_frame"
                {
                    quatf xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                    uniform token[] xformOpOrder = ["xformOp:orient"]
                }
            }

            def Xform "camera_left_link"
            {
                double3 xformOp:translate = (0.000, 0.060, 0.000)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Xform "camera_left_optical_frame"
                {
                    quatf xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                    uniform token[] xformOpOrder = ["xformOp:orient"]
                }
            }

            def Xform "camera_right_link"
            {
                double3 xformOp:translate = (0.000, -0.060, 0.000)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Xform "camera_right_optical_frame"
                {
                    quatf xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                    uniform token[] xformOpOrder = ["xformOp:orient"]
                }
            }
        }
    }
        # -------------------------------------------------------------------------
    # Finite wheel velocity drives
    #
    # Original asset:
    #   damping = 10000000
    #   maxForce = inf
    #
    # Initial tuned values:
    #   damping = 50
    #   maxForce = 3 N*m
    # -------------------------------------------------------------------------
    over "front_left_wheel_joint"
    {
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:damping = 50
        float drive:angular:physics:maxForce = 3.0
        uniform token drive:angular:physics:type = "force"
        float physxJoint:jointFriction = 0
    }

    over "front_right_wheel_joint"
    {
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:damping = 50
        float drive:angular:physics:maxForce = 3.0
        uniform token drive:angular:physics:type = "force"
        float physxJoint:jointFriction = 0
    }

    over "rear_left_wheel_joint"
    {
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:damping = 50
        float drive:angular:physics:maxForce = 3.0
        uniform token drive:angular:physics:type = "force"
        float physxJoint:jointFriction = 0
    }

    over "rear_right_wheel_joint"
    {
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:damping = 50
        float drive:angular:physics:maxForce = 3.0
        uniform token drive:angular:physics:type = "force"
        float physxJoint:jointFriction = 0
    }

    # -------------------------------------------------------------------------
    # Wheel-ground contact material
    #
    # Use moderate isotropic friction. Excessively high friction prevents the
    # four-wheel skid-steer base from releasing lateral scrub during rotation.
    # -------------------------------------------------------------------------
    over "PhysicsMaterials"
    {
        over "wheels"
        {
            float physics:staticFriction = 0.4
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.0
        }
    }

}
