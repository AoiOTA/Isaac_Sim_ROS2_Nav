<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="jackal_wheel"
               params="prefix position_name joint_name x y wheel_radius wheel_width wheel_mass">
    <link name="${prefix}${position_name}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000286" ixy="0" ixz="0"
                 iyy="0.002290" iyz="0" izz="0.002290"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="jackal_tire">
          <color rgba="0.08 0.08 0.08 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <!-- JointState names are the exact robot-YAML contract.  A visual-link
         prefix must never silently rename the controller/odometry joints. -->
    <joint name="${joint_name}" type="continuous">
      <origin xyz="${x} ${y} 0.0345" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${position_name}_wheel_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="jackal_base"
               params="prefix wheel_radius wheel_width geometric_track_width wheelbase base_mass wheel_mass front_left_joint_name front_right_joint_name rear_left_joint_name rear_right_joint_name">
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <mass value="${base_mass}"/>
        <inertia ixx="0.25" ixy="0" ixz="0"
                 iyy="0.35" iyz="0" izz="0.45"/>
      </inertial>
      <visual>
        <origin xyz="0.0125 0 0.14" rpy="0 0 0"/>
        <geometry>
          <box size="0.485 0.420 0.220"/>
        </geometry>
        <material name="jackal_body">
          <color rgba="0.12 0.18 0.22 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0125 0 0.14" rpy="0 0 0"/>
        <geometry>
          <box size="0.485 0.420 0.220"/>
        </geometry>
      </collision>
    </link>

    <xacro:jackal_wheel
        prefix="${prefix}" position_name="front_left"
        joint_name="${front_left_joint_name}"
        x="${float(wheelbase) / 2.0}"
        y="${float(geometric_track_width) / 2.0}"
        wheel_radius="${wheel_radius}" wheel_width="${wheel_width}"
        wheel_mass="${wheel_mass}"/>
    <xacro:jackal_wheel
        prefix="${prefix}" position_name="front_right"
        joint_name="${front_right_joint_name}"
        x="${float(wheelbase) / 2.0}"
        y="${-float(geometric_track_width) / 2.0}"
        wheel_radius="${wheel_radius}" wheel_width="${wheel_width}"
        wheel_mass="${wheel_mass}"/>
    <xacro:jackal_wheel
        prefix="${prefix}" position_name="rear_left"
        joint_name="${rear_left_joint_name}"
        x="${-float(wheelbase) / 2.0}"
        y="${float(geometric_track_width) / 2.0}"
        wheel_radius="${wheel_radius}" wheel_width="${wheel_width}"
        wheel_mass="${wheel_mass}"/>
    <xacro:jackal_wheel
        prefix="${prefix}" position_name="rear_right"
        joint_name="${rear_right_joint_name}"
        x="${-float(wheelbase) / 2.0}"
        y="${-float(geometric_track_width) / 2.0}"
        wheel_radius="${wheel_radius}" wheel_width="${wheel_width}"
        wheel_mass="${wheel_mass}"/>
  </xacro:macro>
</robot>
