<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rf2o_laser_odometry</name>
  <version>0.1.0</version>
  <description>
    Estimation of 2D odometry based on planar laser scans. Useful for mobile robots with inaccurate base odometry.
  </description>

  <maintainer email="jgmonroy@uma.es">Javier G. Monroy</maintainer>
  <license>GPL-3.0-only</license>
  <author email="marianojt@uma.es">Mariano Jaimez</author>
  <author email="jgmonroy@uma.es">Javier G. Monroy</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>eigen3_cmake_module</build_depend>
  <build_export_depend>eigen3_cmake_module</build_export_depend>

  <depend>boost</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
