<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://download.ros.org/2001/XMLSchema"?>
<package format="3">
  <name>bio_nav_a20_nav2_plugins</name>
  <version>0.1.0</version>
  <description>A20 tube-architecture Nav2 plugins: direction-agnostic MPPI
    path-progress critic and goal-frame box goal checker.</description>
  <maintainer email="liang_yibo@hdu.edu.cn">AoiOTA</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
